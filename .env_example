LASTFM_API_KEY=YOUR_LASTFM_API_KEY_HERE
LASTFM_USERNAME=
# Load saved local scrobbles automatically when the dashboard starts (true/false)
AUTO_LOAD_SCROBBLES=false
# Fetch newer scrobbles automatically when the dashboard starts (requires saved scrobbles)
AUTO_FETCH_NEWER_SCROBBLES=false
PORT=3000
MUSICBRAINZ_USER_AGENT=LastFMScrobbleManager/1.0.0 ( https://github.com/user/lastfm-scrobbles )
